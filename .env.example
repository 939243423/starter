# 复制为 .env 后生效（docker compose 与本地开发都读这里）
# 单独运行 backend/ 时它会读 backend/.env（可用 backend/.env.example 生成）
# ===== 后端 =====
PORT=3000
NODE_ENV=development
JWT_SECRET=change_me_to_a_random_string
JWT_EXPIRES_IN=7d
CORS_ORIGIN=*

# ===== 前端（构建期可用，Vite 只暴露 VITE_ 前缀变量）=====
VITE_API_BASE=/api
VITE_APP_TITLE=App Starter
